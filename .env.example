# GEMINI_API_KEY: Gemini API Key (Final Fallback, default model gemini-1.5-flash)
GEMINI_API_KEY=

# GROK_API_KEY: xAI Grok API Key (Attempt 1 - Primary)
GROK_API_KEY=

# OPENROUTER_API_KEY: OpenRouter API Key (Attempt 2 - Fallback 1)
OPENROUTER_API_KEY=

# CLOUDFLARE_API_TOKEN: Cloudflare Workers AI Token (Attempt 3 - Fallback 2)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Turso DB Secrets
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Cloudinary Unsigned Upload Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Telegram Bot Notification Credentials
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
